---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const activities = await getCollection(
    'activities',
    ({ data }) => data.public,
  );
  return activities.map((activity) => ({
    params: { slug: activity.slug },
    props: { activity },
  }));
}

const { activity } = Astro.props;
const { Content } = await activity.render();
---

<Layout
  title={activity.data.title}
  description={activity.data.description}
  image={activity.data.image}
>
  <header class="page-header">
    <div class="prose">
      <Breadcrumbs
        items={[
          { href: '/activities/', label: 'Activities' },
          { href: `/activities/${activity.slug}/`, label: activity.data.title },
        ]}
      />
      <p class="eyebrow">{activity.data.category} · {activity.data.season}</p>
      <h1>{activity.data.title}</h1>
      <p class="lead">{activity.data.description}</p>
    </div>
  </header>
  <article class="content-band prose">
    <img
      class="feature-image"
      src={activity.data.image}
      alt={activity.data.imageAlt ?? `Illustration for ${activity.data.title}`}
    />
    {
      activity.data.gallery && (
        <div class="photo-gallery" aria-label={`${activity.data.title} photos`}>
          {activity.data.gallery.map((photo) => (
            <figure>
              <img src={photo.src} alt={photo.alt} loading="lazy" />
              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }
    <Content />
  </article>
</Layout>

<style>
  .feature-image {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1rem 0 2.5rem;
  }

  .photo-gallery figure {
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .photo-gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .photo-gallery figcaption {
    padding: 0.65rem 0.8rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 620px) {
    .photo-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
