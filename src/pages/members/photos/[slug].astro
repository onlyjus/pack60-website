---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Section from '../../../components/Section.astro';
import CTAButton from '../../../components/CTAButton.astro';
import MemberNav from '../../../components/MemberNav.astro';
import { formatAlbumDate } from '../../../lib/memberContent';

export async function getStaticPaths() {
  const albums = await getCollection(
    'photo-albums',
    ({ data }) => data.published,
  );

  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
const { Content } = await album.render();

const events = await getCollection(
  'member-events',
  ({ data }) => data.published,
);

const relatedEvent = album.data.eventSlug
  ? events.find((event) => event.slug === album.data.eventSlug)
  : undefined;
---

<Layout title={album.data.title} description={album.data.description} noindex>
  <header class="page-header">
    <div class="prose">
      <Breadcrumbs
        items={[
          { href: '/members/', label: 'Members' },
          { href: '/members/photos/', label: 'Photos' },
          { href: `/members/photos/${album.slug}/`, label: album.data.title },
        ]}
      />
      <p class="eyebrow">{formatAlbumDate(album)}</p>
      <h1>{album.data.title}</h1>
      <p class="lead">{album.data.description}</p>
      <MemberNav />
    </div>
  </header>

  <Section>
    <div class="album-intro">
      <article class="prose">
        <Content />
      </article>
      {
        relatedEvent && (
          <div class="album-actions">
            <CTAButton
              href={`/members/events/${relatedEvent.slug}/`}
              variant="secondary"
            >
              View event
            </CTAButton>
          </div>
        )
      }
    </div>

    {
      album.data.images.length > 0 ? (
        <div class="gallery">
          {album.data.images.map((image) => (
            <figure>
              <a href={image.src}>
                <img src={image.src} alt={image.alt} loading="lazy" />
              </a>
              {(image.caption || image.credit) && (
                <figcaption>
                  {image.caption}
                  {image.credit && <span>{image.credit}</span>}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      ) : (
        <p class="empty-state">No photos are published in this album yet.</p>
      )
    }
  </Section>
</Layout>

<style>
  .album-intro {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .album-intro .prose {
    width: auto;
    margin: 0;
  }

  .album-actions {
    flex: 0 0 auto;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  figure {
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 10px 30px rgba(18, 60, 47, 0.06);
  }

  figure a {
    display: block;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  figcaption {
    display: grid;
    gap: 0.25rem;
    color: var(--color-muted);
    font-size: 0.92rem;
    line-height: 1.4;
    padding: 0.85rem;
  }

  figcaption span {
    color: var(--color-gold-dark);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .empty-state {
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .album-intro {
      flex-direction: column;
    }

    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
