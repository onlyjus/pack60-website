---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import MemberNav from '../../../components/MemberNav.astro';
---

<Layout
  title="Member Access Administration"
  description="Manage invitations and private Pack 60 member access."
  noindex
>
  <header class="page-header">
    <div class="prose">
      <Breadcrumbs
        items={[
          { href: '/members/', label: 'Members' },
          { href: '/members/admin/', label: 'Admin' },
        ]}
      />
      <p class="eyebrow">Pack 60 administration</p>
      <h1>Member access</h1>
      <p class="lead">
        Invite families and leaders, review recent sign-ins, assign
        administrators, and remove access when it is no longer needed.
      </p>
      <MemberNav />
    </div>
  </header>

  <div class="admin-shell">
    <div class="summary-grid" aria-label="Access summary">
      <article>
        <span>Active accounts</span>
        <strong data-active-count>—</strong>
      </article>
      <article>
        <span>Administrators</span>
        <strong data-admin-count>—</strong>
      </article>
      <article>
        <span>Removed accounts</span>
        <strong data-revoked-count>—</strong>
      </article>
    </div>

    <section
      class="admin-section invite-section"
      aria-labelledby="invite-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">Invite-only enrollment</p>
          <h2 id="invite-title">Create an invitation</h2>
        </div>
        <p>
          The invitation will only work after Cloudflare SSO verifies the same
          email address.
        </p>
      </div>

      <form class="invite-form" data-invite-form>
        <label>
          Email address
          <input
            name="email"
            type="email"
            autocomplete="email"
            placeholder="family@example.com"
            required
          />
        </label>
        <label>
          Access level
          <select name="role">
            <option value="member">Member</option>
            <option value="admin">Administrator</option>
          </select>
        </label>
        <label>
          Expires after
          <select name="expiresInDays">
            <option value="3">3 days</option>
            <option value="7" selected>7 days</option>
            <option value="14">14 days</option>
            <option value="30">30 days</option>
          </select>
        </label>
        <button type="submit">Generate invite link</button>
      </form>

      <div class="invite-result" data-invite-result hidden>
        <div>
          <strong>Copy this link now</strong>
          <span>For security, the complete link is only shown once.</span>
        </div>
        <div class="copy-row">
          <input
            data-invite-url
            type="text"
            readonly
            aria-label="Invitation link"
          />
          <button type="button" data-copy-invite>Copy</button>
        </div>
      </div>
      <p
        class="admin-status"
        data-admin-status
        role="status"
        aria-live="polite"
      >
      </p>
    </section>

    <section class="admin-section" aria-labelledby="accounts-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Authorization</p>
          <h2 id="accounts-title">Member accounts</h2>
        </div>
        <p>
          Removing access is immediate and preserves the record for auditing.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Member</th>
              <th scope="col">Role</th>
              <th scope="col">Last SSO sign-in</th>
              <th scope="col">Last activity</th>
              <th scope="col">Status</th>
              <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody data-members-body>
            <tr><td colspan="6" class="loading-cell">Loading accounts…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="admin-section" aria-labelledby="invites-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Enrollment history</p>
          <h2 id="invites-title">Recent invitations</h2>
        </div>
        <p>Unused invitation links can be revoked at any time.</p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Role</th>
              <th scope="col">Created</th>
              <th scope="col">Expires</th>
              <th scope="col">Status</th>
              <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody data-invites-body>
            <tr
              ><td colspan="6" class="loading-cell">Loading invitations…</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>

<script>
  interface Member {
    id: string;
    email: string;
    display_name: string | null;
    role: 'member' | 'admin';
    status: 'active' | 'revoked';
    last_login_at: string | null;
    last_seen_at: string | null;
    revoked_at: string | null;
  }

  interface Invite {
    id: string;
    email: string;
    role: 'member' | 'admin';
    created_at: string;
    expires_at: string;
    redeemed_at: string | null;
    revoked_at: string | null;
  }

  interface MembersResponse {
    members: Member[];
    summary: {
      activeCount: number;
      adminCount: number;
      revokedCount: number;
    };
  }

  interface InvitesResponse {
    invites: Invite[];
  }

  interface InviteCreateResponse {
    invite: Invite;
    inviteUrl: string;
  }

  interface MeResponse {
    member: { id: string };
  }

  const membersBody = document.querySelector<HTMLTableSectionElement>(
    '[data-members-body]',
  );
  const invitesBody = document.querySelector<HTMLTableSectionElement>(
    '[data-invites-body]',
  );
  const inviteForm =
    document.querySelector<HTMLFormElement>('[data-invite-form]');
  const inviteResult = document.querySelector<HTMLElement>(
    '[data-invite-result]',
  );
  const inviteUrl =
    document.querySelector<HTMLInputElement>('[data-invite-url]');
  const copyButton =
    document.querySelector<HTMLButtonElement>('[data-copy-invite]');
  const status = document.querySelector<HTMLElement>('[data-admin-status]');
  let currentMemberId = '';

  function escapeHtml(value: string): string {
    return value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function formatDate(value: string | null): string {
    if (!value) return 'Never';
    return new Intl.DateTimeFormat('en-US', {
      dateStyle: 'medium',
      timeStyle: 'short',
    }).format(new Date(value));
  }

  async function api<T>(path: string, init: RequestInit = {}): Promise<T> {
    const headers = new Headers(init.headers);
    headers.set('X-Requested-With', 'XMLHttpRequest');
    const response = await fetch(path, { ...init, headers });
    const data = (await response.json()) as T & { error?: string };

    if (!response.ok) {
      throw new Error(data.error ?? 'The request could not be completed.');
    }

    return data;
  }

  function setStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('error', isError);
  }

  function renderMembers(members: Member[]) {
    if (!membersBody) return;
    if (members.length === 0) {
      membersBody.innerHTML =
        '<tr><td colspan="6" class="loading-cell">No member accounts yet.</td></tr>';
      return;
    }

    membersBody.innerHTML = members
      .map((member) => {
        const isCurrent = member.id === currentMemberId;
        const action = member.status === 'active' ? 'revoke' : 'reactivate';
        const actionLabel =
          member.status === 'active' ? 'Remove access' : 'Restore access';
        const displayName = member.display_name
          ? `<strong>${escapeHtml(member.display_name)}</strong>`
          : '';

        return `<tr>
          <td>${displayName}<span>${escapeHtml(member.email)}${isCurrent ? ' · You' : ''}</span></td>
          <td>
            <select class="role-select" data-role-member="${escapeHtml(member.id)}" aria-label="Role for ${escapeHtml(member.email)}" ${member.status === 'revoked' ? 'disabled' : ''}>
              <option value="member" ${member.role === 'member' ? 'selected' : ''}>Member</option>
              <option value="admin" ${member.role === 'admin' ? 'selected' : ''}>Administrator</option>
            </select>
          </td>
          <td>${escapeHtml(formatDate(member.last_login_at))}</td>
          <td>${escapeHtml(formatDate(member.last_seen_at))}</td>
          <td><span class="status-pill ${member.status}">${member.status === 'active' ? 'Active' : 'Removed'}</span></td>
          <td><button class="table-action ${action === 'revoke' ? 'danger' : ''}" type="button" data-member-action="${action}" data-member-id="${escapeHtml(member.id)}" data-member-email="${escapeHtml(member.email)}" ${isCurrent ? 'disabled title="You cannot remove your own access"' : ''}>${actionLabel}</button></td>
        </tr>`;
      })
      .join('');
  }

  function inviteStatus(invite: Invite): { label: string; className: string } {
    if (invite.revoked_at) return { label: 'Revoked', className: 'revoked' };
    if (invite.redeemed_at) return { label: 'Redeemed', className: 'redeemed' };
    if (new Date(invite.expires_at).getTime() <= Date.now()) {
      return { label: 'Expired', className: 'expired' };
    }
    return { label: 'Ready', className: 'active' };
  }

  function renderInvites(invites: Invite[]) {
    if (!invitesBody) return;
    if (invites.length === 0) {
      invitesBody.innerHTML =
        '<tr><td colspan="6" class="loading-cell">No invitations yet.</td></tr>';
      return;
    }

    invitesBody.innerHTML = invites
      .map((invite) => {
        const state = inviteStatus(invite);
        const canRevoke = state.className === 'active';
        return `<tr>
          <td><strong>${escapeHtml(invite.email)}</strong></td>
          <td>${invite.role === 'admin' ? 'Administrator' : 'Member'}</td>
          <td>${escapeHtml(formatDate(invite.created_at))}</td>
          <td>${escapeHtml(formatDate(invite.expires_at))}</td>
          <td><span class="status-pill ${state.className}">${state.label}</span></td>
          <td>${canRevoke ? `<button class="table-action danger" type="button" data-invite-action="revoke" data-invite-id="${escapeHtml(invite.id)}" data-invite-email="${escapeHtml(invite.email)}">Revoke link</button>` : ''}</td>
        </tr>`;
      })
      .join('');
  }

  async function loadMembers() {
    const data = await api<MembersResponse>('/api/members/admin/members');
    renderMembers(data.members);
    const activeCount = document.querySelector('[data-active-count]');
    const adminCount = document.querySelector('[data-admin-count]');
    const revokedCount = document.querySelector('[data-revoked-count]');
    if (activeCount) activeCount.textContent = String(data.summary.activeCount);
    if (adminCount) adminCount.textContent = String(data.summary.adminCount);
    if (revokedCount)
      revokedCount.textContent = String(data.summary.revokedCount);
  }

  async function loadInvites() {
    const data = await api<InvitesResponse>('/api/members/admin/invites');
    renderInvites(data.invites);
  }

  inviteForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const submit = inviteForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const formData = new FormData(inviteForm);
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Generating…';
    }
    setStatus('');

    try {
      const data = await api<InviteCreateResponse>(
        '/api/members/admin/invites',
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: formData.get('email'),
            role: formData.get('role'),
            expiresInDays: Number(formData.get('expiresInDays')),
          }),
        },
      );
      if (inviteUrl) inviteUrl.value = data.inviteUrl;
      if (inviteResult) inviteResult.hidden = false;
      setStatus(`Invitation created for ${data.invite.email}.`);
      inviteForm.reset();
      await loadInvites();
    } catch (error) {
      setStatus(
        error instanceof Error ? error.message : 'Could not create invitation.',
        true,
      );
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Generate invite link';
      }
    }
  });

  copyButton?.addEventListener('click', async () => {
    if (!inviteUrl?.value) return;
    try {
      await navigator.clipboard.writeText(inviteUrl.value);
      copyButton.textContent = 'Copied';
      setTimeout(() => (copyButton.textContent = 'Copy'), 1600);
    } catch {
      inviteUrl.select();
      setStatus('The link is selected. Copy it using your device menu.');
    }
  });

  membersBody?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-member-action]',
    );
    if (!button) return;
    const action = button.dataset.memberAction;
    const memberId = button.dataset.memberId;
    const email = button.dataset.memberEmail;
    if (!action || !memberId || !email) return;
    const verb =
      action === 'revoke' ? 'remove access for' : 'restore access for';
    if (!window.confirm(`Are you sure you want to ${verb} ${email}?`)) return;

    button.disabled = true;
    try {
      await api(`/api/members/admin/members/${encodeURIComponent(memberId)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action }),
      });
      setStatus(
        action === 'revoke'
          ? `Access removed for ${email}.`
          : `Access restored for ${email}.`,
      );
      await loadMembers();
    } catch (error) {
      setStatus(
        error instanceof Error ? error.message : 'Could not update access.',
        true,
      );
      button.disabled = false;
    }
  });

  membersBody?.addEventListener('change', async (event) => {
    const select = (event.target as HTMLElement).closest<HTMLSelectElement>(
      '[data-role-member]',
    );
    if (!select?.dataset.roleMember) return;

    try {
      await api(
        `/api/members/admin/members/${encodeURIComponent(select.dataset.roleMember)}`,
        {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'setRole', role: select.value }),
        },
      );
      setStatus('Member role updated.');
      await loadMembers();
    } catch (error) {
      setStatus(
        error instanceof Error ? error.message : 'Could not update the role.',
        true,
      );
      await loadMembers();
    }
  });

  invitesBody?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-invite-action]',
    );
    if (!button?.dataset.inviteId) return;
    const email = button.dataset.inviteEmail ?? 'this email';
    if (!window.confirm(`Revoke the unused invitation for ${email}?`)) return;

    button.disabled = true;
    try {
      await api(
        `/api/members/admin/invites/${encodeURIComponent(button.dataset.inviteId)}`,
        {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'revoke' }),
        },
      );
      setStatus(`Invitation revoked for ${email}.`);
      await loadInvites();
    } catch (error) {
      setStatus(
        error instanceof Error ? error.message : 'Could not revoke invitation.',
        true,
      );
      button.disabled = false;
    }
  });

  Promise.all([api<MeResponse>('/api/members/me'), loadInvites()])
    .then(([me]) => {
      currentMemberId = me.member.id;
      return loadMembers();
    })
    .catch((error) => {
      setStatus(
        error instanceof Error
          ? error.message
          : 'Could not load access records.',
        true,
      );
    });
</script>

<style>
  .admin-shell {
    width: min(var(--max-width), calc(100% - 2rem));
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .summary-grid article,
  .admin-section {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 10px 30px rgba(18, 60, 47, 0.06);
  }

  .summary-grid article {
    padding: 1.25rem;
  }

  .summary-grid span {
    display: block;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 750;
  }

  .summary-grid strong {
    display: block;
    margin-top: 0.3rem;
    color: var(--color-green);
    font-size: 2.35rem;
    line-height: 1;
  }

  .admin-section {
    margin-top: 1.25rem;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .invite-section {
    border-top: 5px solid var(--color-gold);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .section-heading h2 {
    margin: 0;
    color: var(--color-green);
    font-size: clamp(1.5rem, 4vw, 2.1rem);
  }

  .section-heading > p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.96rem;
  }

  .invite-form {
    display: grid;
    grid-template-columns:
      minmax(230px, 1.5fr) minmax(150px, 0.7fr) minmax(140px, 0.6fr)
      auto;
    gap: 0.85rem;
    align-items: end;
  }

  label {
    display: grid;
    gap: 0.35rem;
    color: var(--color-green);
    font-size: 0.87rem;
    font-weight: 800;
  }

  input,
  select,
  button {
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
    color: var(--color-text);
    font: inherit;
  }

  input,
  select {
    padding: 0.6rem 0.7rem;
  }

  button {
    cursor: pointer;
    font-weight: 800;
    padding: 0.6rem 0.85rem;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .invite-form button,
  .copy-row button {
    border-color: var(--color-green);
    background: var(--color-green);
    color: #fff;
  }

  .invite-result {
    display: grid;
    grid-template-columns: minmax(180px, 0.65fr) minmax(0, 1.35fr);
    gap: 1rem;
    margin-top: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface-alt);
    padding: 1rem;
  }

  .invite-result[hidden] {
    display: none;
  }

  .invite-result strong,
  .invite-result span {
    display: block;
  }

  .invite-result strong {
    color: var(--color-green);
  }

  .invite-result span {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .copy-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
  }

  .admin-status {
    min-height: 1.4rem;
    margin: 0.8rem 0 0;
    color: var(--color-green-2);
    font-size: 0.94rem;
    font-weight: 750;
  }

  .admin-status.error {
    color: #8f2f2a;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  th,
  td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.8rem 0.65rem;
    text-align: left;
    vertical-align: middle;
  }

  th {
    color: var(--color-muted);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  td strong,
  td span:not(.status-pill) {
    display: block;
  }

  td span:not(.status-pill) {
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .role-select {
    min-width: 135px;
    min-height: 38px;
    padding: 0.4rem 0.55rem;
    font-size: 0.86rem;
  }

  .status-pill {
    display: inline-flex;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-green);
    font-size: 0.77rem;
    font-weight: 850;
    line-height: 1;
    padding: 0.45rem 0.6rem;
  }

  .status-pill.revoked,
  .status-pill.expired {
    background: #f3ece6;
    color: #73503a;
  }

  .status-pill.redeemed {
    background: #e8eef5;
    color: var(--color-blue);
  }

  .table-action {
    min-height: 36px;
    white-space: nowrap;
    background: #fff;
    font-size: 0.82rem;
    padding: 0.4rem 0.6rem;
  }

  .table-action.danger {
    border-color: #d8b7b3;
    color: #8f2f2a;
  }

  .loading-cell {
    color: var(--color-muted);
    text-align: center;
    padding: 2rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .invite-form {
      grid-template-columns: 1fr 1fr;
    }

    .invite-form label:first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 680px) {
    .summary-grid,
    .invite-form,
    .invite-result {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading > p {
      margin-top: 0.65rem;
    }
  }
</style>
