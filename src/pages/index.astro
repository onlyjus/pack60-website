---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import ActivityCard from '../components/ActivityCard.astro';
import CTAButton from '../components/CTAButton.astro';

const featuredActivitySlugs = [
  'cub-scout-resident-camp',
  'pinewood-derby',
  'caving-at-laurel-caverns',
  'stem-rockets-science',
  'community-events',
  'good-zoo-overnight',
];
const activities = (
  await getCollection('activities', ({ data }) => data.public)
)
  .filter((activity) => featuredActivitySlugs.includes(activity.slug))
  .sort(
    (a, b) =>
      featuredActivitySlugs.indexOf(a.slug) -
      featuredActivitySlugs.indexOf(b.slug),
  );

const meetingMapsUrl =
  'https://www.google.com/maps/search/?api=1&query=479+Van+Voorhis+Rd%2C+Morgantown%2C+WV';
const facebookUrl = 'https://www.facebook.com/pack60wv/';
const beAScoutUrl =
  'https://beascout.scouting.org/list/?zip=26505&program[0]=pack&cubFilter=all&miles=10&unitID=43232';
const recentHighlights = [
  {
    title: 'Brookhaven conservation project',
    meta: 'Community service · July 28, 2026',
    href: 'https://www.facebook.com/pack60wv/posts/pfbid02Sz9uxPyko9xyHoANyaDfiRmmVKwzDWgGCKbCurpBNZYgCdjk1KnF2Svr2Lyo3sBTl',
    image: '/images/illustrations/service.svg',
    imageAlt: 'Illustration representing a community service project',
    description:
      'Pack 60 and Pack 52 worked together on a conservation and landscaping project at Brookhaven Elementary, helping make the community more beautiful.',
  },
  {
    title: 'Camp Mountaineer resident camp',
    meta: 'Summer camp adventure',
    href: 'https://www.facebook.com/pack60wv/posts/pfbid02dMnCmqd9zuWmjXqZXzEMpzABhrUagwjKM7QwBnEa2CCwM9katAZZ7iKJhSe3DK1zl',
    image: '/images/activities/camp-mountaineer-climbing.jpg',
    imageAlt:
      'A scout climbing at Camp Mountaineer with support from camp staff',
    description:
      'Scouts spent a week climbing, enjoying lake activities, practicing shooting sports, making crafts, and sharing a themed camp adventure.',
  },
  {
    title: 'Black Bears overnight',
    meta: 'Summer adventure',
    href: 'https://www.facebook.com/pack60wv/posts/pfbid02mEc4B8QDh3RqnyJjnhvTXAYf6Mm4uM293k1vFqPziX1BkcPxRFikpvtpiaoYcKeJl',
    image: '/images/activities/black-bears-pack60.jpg',
    imageAlt:
      'Pack 60 scouts with the West Virginia Black Bears mascot at the ballpark',
    description:
      'Scouts enjoyed baseball, fireworks, a movie, and an overnight campout on the field.',
  },
];
---

<Layout
  title="Cub Scout Pack 60"
  description="Adventure, character, outdoor skills, and family fun with Cub Scout Pack 60 in the Morgantown, WV area."
>
  <Hero
    eyebrow="Cub Scout Pack 60"
    title="Find your next adventure."
    description="Girls and boys in kindergarten through fifth grade build confidence, friendships, and practical skills through real adventures with Pack 60 families in Morgantown."
    primaryHref="/join/"
    primaryLabel="Plan a visit"
    secondaryHref="/activities/"
    secondaryLabel="See what we do"
  />

  <div class="trust-strip" aria-label="Pack 60 at a glance">
    <div class="container trust-grid">
      <p><strong>Girls & boys</strong><span>Kindergarten–5th grade</span></p>
      <p>
        <strong>Tuesdays at 7 PM</strong><span
          >Suncrest United Methodist Church</span
        >
      </p>
      <p>
        <strong>Family-centered</strong><span>Parents share the adventure</span>
      </p>
      <p>
        <strong>Morgantown-based</strong><span
          >Local outings and community events</span
        >
      </p>
    </div>
  </div>

  <Section
    eyebrow="Why Pack 60?"
    title="Local adventures. Lasting confidence."
    intro="Pack 60 combines a welcoming weekly rhythm with experiences children remember: outdoor challenges, creative projects, community service, and time with friends."
  >
    <CardGrid columns="three">
      <Card title="Remarkable local adventures">
        <p>
          Scouts camp at Camp Mountaineer, explore Laurel Caverns, stay
          overnight at the Good Zoo, attend baseball overnights, hike, fish, and
          try new outdoor skills.
        </p>
      </Card>
      <Card title="Learning by doing">
        <p>
          Pinewood Derby, WVU STEM Day, civic visits, crafts, service, and
          age-appropriate challenges turn curiosity into confidence.
        </p>
      </Card>
      <Card title="A community for families">
        <p>
          Parents and guardians participate alongside scouts while children make
          friends in grade-level dens and across the whole pack.
        </p>
      </Card>
    </CardGrid>
  </Section>

  <Section
    variant="alt"
    eyebrow="Activities"
    title="Always something to look forward to"
    intro="From Pinewood Derby to campouts, service projects, hikes, STEM nights, and pack meetings, Pack 60 gives scouts many ways to try new things."
  >
    <CardGrid columns="three">
      {
        activities.map((activity) => (
          <ActivityCard
            title={activity.data.title}
            description={activity.data.description}
            href={`/activities/${activity.slug}/`}
            season={activity.data.season}
            image={activity.data.image}
            imageAlt={activity.data.imageAlt}
          />
        ))
      }
    </CardGrid>
  </Section>

  <Section
    title="Meeting overview"
    intro="Pack 60 meets Tuesdays at 7:00 PM at Suncrest United Methodist Church in Morgantown, WV, with additional outings, service projects, and special events shared through official pack communication channels."
  >
    <div class="two-column">
      <div class="surface">
        <h2>When and where we meet</h2>
        <p>
          Families interested in Pack 60 are welcome to ask about visiting a
          meeting. We meet <strong>Tuesdays at 7:00 PM</strong> at
          <a href={meetingMapsUrl}>Suncrest United Methodist Church</a> in Morgantown,
          WV, at 479 Van Voorhis Road.
        </p>
        <p>
          Please contact the pack before your first visit so a volunteer can
          confirm the best arrival details and any schedule changes.
        </p>
      </div>
    </div>
  </Section>

  <Section
    variant="alt"
    eyebrow="Year at a glance"
    title="A full year of adventure"
    intro="Pack 60 balances a dependable meeting rhythm with special traditions, outdoor weekends, community service, and optional summer adventures."
  >
    <CardGrid columns="three">
      <Card title="Winter & spring" meta="January–May">
        <p>
          Planetarium night, Pinewood Derby, WVU STEM Day, Scouting for Food, a
          Botanic Garden hike, spring camping, and Blue & Gold.
        </p>
      </Card>
      <Card title="Summer adventures" meta="June–August">
        <p>
          Day camp, fishing, rail-trail service, the Morgantown parade, Black
          Bears Scout Night, resident camp, lake adventures, and a pool party.
        </p>
      </Card>
      <Card title="Fall & holidays" meta="September–December">
        <p>
          Camp Mountaineer family camping, Raingutter Regatta, fall hikes, Trunk
          or Treat, Cubsgiving, the Veterans Day Parade, and a winter hike.
        </p>
      </Card>
    </CardGrid>
    <p class="calendar-more">
      <CTAButton href="/calendar/" variant="secondary">
        Explore the full year
      </CTAButton>
    </p>
  </Section>

  <Section
    title="A look at Pack 60 in action"
    eyebrow="Recent Facebook highlights"
    intro="Pack 60 adventures go beyond regular meetings. These recent public posts show scouts learning, serving, creating, and spending time outdoors together."
  >
    <CardGrid columns="three">
      {
        recentHighlights.map((highlight) => (
          <Card
            title={highlight.title}
            meta={highlight.meta}
            href={highlight.href}
            image={highlight.image}
            imageAlt={highlight.imageAlt}
          >
            <p>{highlight.description}</p>
          </Card>
        ))
      }
    </CardGrid>
    <p class="facebook-more">
      <CTAButton href={facebookUrl} variant="secondary">
        See more Pack 60 updates on Facebook
      </CTAButton>
    </p>
  </Section>

  <Section title="Ready to learn more?">
    <div class="cta-panel">
      <div>
        <h2>Come see Pack 60 in action.</h2>
        <p>
          Start by planning a Tuesday visit. A pack volunteer will confirm the
          schedule, welcome your family, and introduce your child to the right
          grade-level den.
        </p>
      </div>
      <div class="cta-actions">
        <CTAButton href="/join/">Plan a visit</CTAButton>
        <CTAButton href={beAScoutUrl} variant="secondary"
          >Official BeAScout listing</CTAButton
        >
      </div>
    </div>
  </Section>
</Layout>

<style>
  .trust-strip {
    border-bottom: 1px solid var(--color-border);
    background: #fff;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .trust-grid p {
    margin: 0;
    padding: 1.1rem;
    text-align: center;
  }

  .trust-grid strong,
  .trust-grid span {
    display: block;
  }

  .trust-grid strong {
    color: var(--color-green);
    line-height: 1.25;
  }

  .trust-grid span {
    margin-top: 0.2rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .surface h2,
  .cta-panel h2 {
    margin: 0 0 0.5rem;
    color: var(--color-green);
    line-height: 1.15;
  }

  .surface p,
  .cta-panel p {
    color: var(--color-muted);
  }

  .cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-radius: var(--radius);
    background: var(--color-green);
    color: #fff;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .cta-panel h2 {
    color: #fff;
  }

  .cta-panel p {
    max-width: 65ch;
    margin: 0;
    color: rgba(255, 255, 255, 0.86);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .facebook-more {
    margin: 1.5rem 0 0;
  }

  .calendar-more {
    margin: 1.5rem 0 0;
  }

  @media (max-width: 760px) {
    .trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-grid p {
      border-bottom: 1px solid var(--color-border);
    }

    .cta-panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
