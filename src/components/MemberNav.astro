---
const navItems = [
  { href: '/members/', label: 'Overview' },
  { href: '/members/calendar/', label: 'Calendar' },
  { href: '/members/budget/', label: 'Budget' },
  { href: '/members/photos/', label: 'Photos' },
];
---

<nav class="member-nav" aria-label="Member navigation">
  {
    navItems.map((item) => (
      <a
        href={item.href}
        aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))
  }
  <a class="admin-link" href="/members/admin/" hidden>Admin</a>
  <a class="logout-link" href="/cdn-cgi/access/logout">Log out</a>
</nav>

<script>
  interface MeResponse {
    member: { role: 'member' | 'admin' };
  }

  const adminLink = document.querySelector<HTMLAnchorElement>('.admin-link');

  fetch('/api/members/me', {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
  })
    .then((response) =>
      response.ok ? (response.json() as Promise<MeResponse>) : null,
    )
    .then((data) => {
      if (data?.member?.role === 'admin' && adminLink) {
        adminLink.hidden = false;
      }
    })
    .catch(() => undefined);
</script>

<style>
  .member-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  a {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
    color: var(--color-green);
    font-size: 0.94rem;
    font-weight: 800;
    line-height: 1.15;
    padding: 0.55rem 0.85rem;
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    border-color: var(--color-green);
    background: var(--color-green);
    color: #fff;
  }

  .logout-link {
    margin-left: auto;
    border-color: transparent;
    background: transparent;
  }

  .logout-link:hover {
    border-color: var(--color-border);
    background: #fff;
    color: var(--color-green);
  }

  @media (max-width: 560px) {
    .logout-link {
      margin-left: 0;
    }
  }
</style>
