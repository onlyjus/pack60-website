---
interface Props {
  title?: string;
  href?: string;
  meta?: string;
  image?: string;
  imageAlt?: string;
}

const { title, href, meta, image, imageAlt = '' } = Astro.props;
const TitleTag = href ? 'a' : 'span';
---

<article class:list={['card', { 'has-image': image }]}>
  {
    image && (
      <img class="card-image" src={image} alt={imageAlt} loading="lazy" />
    )
  }
  <div class="card-content">
    {meta && <p class="card-meta">{meta}</p>}
    {
      title && (
        <h3>
          <TitleTag href={href}>{title}</TitleTag>
        </h3>
      )
    }
    <div class="card-body">
      <slot />
    </div>
  </div>
</article>

<style>
  .card {
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 10px 30px rgba(18, 60, 47, 0.06);
    padding: 1.15rem;
  }

  .card.has-image {
    overflow: hidden;
    padding: 0;
  }

  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-surface-alt);
  }

  .card-content {
    height: 100%;
  }

  .has-image .card-content {
    height: auto;
    padding: 1.15rem;
  }

  .card h3 {
    margin: 0.2rem 0 0.5rem;
    color: var(--color-green);
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .card h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .card-meta {
    margin: 0;
    color: var(--color-gold-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-body :global(p) {
    margin: 0;
    color: var(--color-muted);
  }
</style>
