---
const facebookUrl = 'https://www.facebook.com/pack60wv/';
---

<dialog
  class="construction-notice"
  id="construction-notice"
  aria-labelledby="construction-notice-title"
  aria-describedby="construction-notice-description"
>
  <div class="notice-accent" aria-hidden="true"></div>
  <form method="dialog">
    <button class="notice-close" value="close" aria-label="Close notice">
      <span aria-hidden="true">&times;</span>
    </button>
  </form>

  <div class="notice-content">
    <p class="notice-eyebrow">Website update</p>
    <h2 id="construction-notice-title">We&rsquo;re still building!</h2>
    <p id="construction-notice-description">
      The Pack 60 website is under construction. For the latest pack news,
      announcements, and event information, please visit our Facebook page.
    </p>

    <div class="notice-actions">
      <a
        class="notice-primary"
        href={facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-facebook-link
      >
        Visit Pack 60 on Facebook
        <span aria-hidden="true">&rarr;</span>
      </a>
      <form method="dialog">
        <button class="notice-secondary" value="continue">
          Continue to website
        </button>
      </form>
    </div>
  </div>
</dialog>

<script>
  const notice = document.querySelector<HTMLDialogElement>(
    '#construction-notice',
  );
  const facebookLink = notice?.querySelector<HTMLAnchorElement>(
    '[data-facebook-link]',
  );
  const storageKey = 'pack60-construction-notice-dismissed';

  const rememberDismissal = () => {
    try {
      sessionStorage.setItem(storageKey, 'true');
    } catch {
      // The notice still works when browser storage is unavailable.
    }
  };

  let wasDismissed = false;

  try {
    wasDismissed = sessionStorage.getItem(storageKey) === 'true';
  } catch {
    // Show the notice when browser storage is unavailable.
  }

  if (notice && !wasDismissed) {
    notice.showModal();
    facebookLink?.focus();
  }

  notice?.addEventListener('close', rememberDismissal);
  facebookLink?.addEventListener('click', rememberDismissal);
</script>

<style>
  .construction-notice {
    width: min(560px, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    overflow: auto;
    border: 0;
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-text);
    padding: 0;
    box-shadow: 0 28px 80px rgba(10, 35, 27, 0.3);
  }

  .construction-notice[open] {
    animation: notice-enter 180ms ease-out;
  }

  .construction-notice::backdrop {
    background: rgba(10, 35, 27, 0.7);
    backdrop-filter: blur(4px);
  }

  .notice-accent {
    height: 8px;
    background: var(--color-gold);
  }

  .notice-close {
    position: absolute;
    top: 1.15rem;
    right: 1.15rem;
    display: inline-grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-green);
    cursor: pointer;
    font: inherit;
    font-size: 1.65rem;
    line-height: 1;
  }

  .notice-close:hover {
    border-color: var(--color-green-2);
    background: #fff;
  }

  .notice-content {
    padding: clamp(2rem, 7vw, 3.25rem);
    padding-top: clamp(2.75rem, 9vw, 4rem);
  }

  .notice-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-gold-dark);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 3rem 0.9rem 0;
    color: var(--color-green);
    font-size: clamp(2rem, 8vw, 3rem);
    line-height: 1.05;
  }

  #construction-notice-description {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .notice-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .notice-actions form {
    display: contents;
  }

  .notice-primary,
  .notice-secondary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius);
    padding: 0.7rem 1rem;
    cursor: pointer;
    font: inherit;
    font-size: 0.94rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
  }

  .notice-primary {
    border: 1px solid var(--color-green);
    background: var(--color-green);
    color: #fff;
  }

  .notice-primary:hover {
    border-color: var(--color-green-2);
    background: var(--color-green-2);
    color: #fff;
  }

  .notice-secondary {
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-green);
  }

  .notice-secondary:hover {
    border-color: var(--color-green-2);
    background: var(--color-surface-alt);
  }

  @keyframes notice-enter {
    from {
      transform: translateY(12px) scale(0.98);
      opacity: 0;
    }

    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  @media (max-width: 520px) {
    .notice-actions,
    .notice-primary,
    .notice-secondary {
      width: 100%;
    }

    .notice-content {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .construction-notice[open] {
      animation: none;
    }
  }
</style>
